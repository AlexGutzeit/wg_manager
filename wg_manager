usage() {
    cat <<EOF
wg_manager – WireGuard-Zugänge verwalten
  Ohne Argumente: Menü – mit Pfeiltasten wählen, Enter öffnet, Esc geht zurück, q beendet.
  wg_manager menue-einfach: das frühere Zahlenmenü. Alles aus dem Menü gibt es auch als Befehl:

  liste                              Tunnel und Geräte mit Status
  netze                              Netze des Routers, in die man einhängen kann
  zeige <gerät> [--raw]              Gerätekonfiguration (--raw: nur die Datei)
  qr <gerät>                         Gerätekonfiguration als QR-Code für die WireGuard-App
  geraet-neu <tunnel> <name> [--ohne-psk]
  geraet-sperren <name> | geraet-entsperren <name> | geraet-loeschen <name>
  tunnel-neu <name> [--netz "client wan ..."] [--zugriff beides|netz|internet] [--admin 0|1] [--freifunk 0|1] [--port N] [--dns "..."] [--mtu N|auto]
  tunnel-aendern <name> [--netz "..."] [--zugriff ...] [--admin 0|1] [--freifunk 0|1] [--dns "..."] [--mtu N|auto]
  mtu-messen [ziel]                  Strecke des Routers ins Internet messen, passende Tunnel-MTU vorschlagen
                                     (MTU $MTU_MIN–$MTU_MAX, ohne Angabe $MTU_DEFAULT; auto = gemessen; DSL 1412 → 1332, 1500 → 1420)
  tunnel-loeschen <name>
  apply [-q]                         alles aus /etc/config/wgmanager neu anwenden

Babel-Verbindungen (zwei Freifunk-Router koppeln, z. B. einen Router hinter LTE):
  babel-neu <name> [--port N] [--rxcost N]
                                     Seite A: lauscht auf ihrer Freifunk-IPv6, gibt eine Zeile zum Einfügen aus
  babel-einfuegen ["<zeile>"] [--name N] [--rxcost N]
                                     Seite B: Zeile von A einfügen (ohne Angabe: wird abgefragt), verbindet sich
  babel-zeige <name>                 Zeile erneut ausgeben (Seite A)
  babel-mtu <name>                   MTU jetzt neu aushandeln
  babel-aendern <name> --rxcost N    Babel-Kosten ändern (1–65535, beide Seiten; auf dem anderen Router gleich einstellen)
  babel-loeschen <name>
  babel-pruefen [-q]                 Wächter (cron, jede Minute): stellt Fehlendes wieder her, handelt die MTU aus

Netzverbindungen (ein Netz von Router A aus einem Netz von Router B erreichen, z. B. einen Drucker; nur IPv4):
  netz-neu <name> [--netz wan|<netz>] [--ersatz a.b.c.d/p] [--port N]
                                     Seite A: gibt ein Netz frei (ohne Angabe: WAN), gibt eine Zeile zum Einfügen aus
  netz-einfuegen ["<zeile>"] [--name N] [--netz "client ..."] [--ohne-ersatz]
                                     Seite B: Zeile von A einfügen; bei gleichen Netzen gilt das Ersatznetz
                                     (letzte Zahl gleich), mit --ohne-ersatz wird dann abgelehnt
  netz-zeige <name>                  Zeile erneut ausgeben (Seite A)
  netz-loeschen <name>
  migrate [--dns "..."]              Altbestand (wg_manager v1/privwg) übernehmen
EOF
}

# ---------------------------------------------------------------------------

LOCK=/var/lock/wg_manager.lock
case "$1" in
    # Menü mit Pfeiltasten nur an einem echten Terminal, sonst (z. B. per Pipe) das Zahlenmenü
    ""|menu|menue) ensure_env; if [ -t 0 ] && [ -t 1 ]; then tui_main; else menu_classic; fi ;;
    menue-einfach|menu-classic) ensure_env; menu_classic ;;
    hilfe|help|-h|--help) usage ;;
    liste|list|status) ensure_env; cmd_list ;;
    netze|nets) cmd_nets ;;
    mtu-messen|mtu) ensure_env; shift; cmd_mtu_check "$1" ;;
    zeige|show) ensure_env; shift; cmd_show "$@" ;;
    qr) ensure_env; shift; cmd_qr "$1" ;;
    babel-zeige) ensure_env; shift; cmd_babel_show "$1" ;;
    netz-zeige) ensure_env; shift; cmd_link_show "$1" ;;
    *)
        # Sperre auch bei Abbruch (Strg-C, abgeschnittene Ausgabe) freigeben, sonst hängen alle weiteren Aufrufe.
        # Der Wächter wartet nicht: läuft gerade ein anderer Aufruf, setzt er diese Runde aus (sonst stauen sich
        # bei einer hängenden Sperre jede Minute neue Prozesse).
        if [ -x /bin/lock ]; then
            if [ "$1" = babel-pruefen ]; then lock -n "$LOCK" 2>/dev/null || exit 0; else lock "$LOCK"; fi
            trap 'lock -u "$LOCK"' EXIT; trap 'exit 1' INT TERM HUP PIPE
        fi
        ensure_env
        c="$1"; shift
        [ "$1" = "-q" ] && { QUIET=1; shift; }
        case "$c" in
            apply) cmd_apply ;;
            migrate) cmd_migrate "$@" ;;
            geraet-neu|peer-add) cmd_peer_add "$@" ;;
            geraet-loeschen|peer-del) cmd_peer_del "$1" ;;
            geraet-sperren) cmd_peer_enable "$1" 0 ;;
            geraet-entsperren) cmd_peer_enable "$1" 1 ;;
            tunnel-neu|tunnel-add) cmd_tunnel_add "$@" ;;
            tunnel-aendern|tunnel-edit) cmd_tunnel_edit "$@" ;;
            tunnel-loeschen|tunnel-del) cmd_tunnel_del "$1" ;;
            babel-neu) cmd_babel_add "$@" ;;
            babel-einfuegen) cmd_babel_insert "$@" ;;
            babel-mtu) cmd_babel_mtu "$1" ;;
            babel-aendern) cmd_babel_edit "$@" ;;
            babel-loeschen) cmd_babel_del "$1" ;;
            babel-pruefen) cmd_babel_check ;;
            netz-neu) cmd_link_add "$@" ;;
            netz-einfuegen) cmd_link_insert "$@" ;;
            netz-loeschen) cmd_link_del "$1" ;;
            *) usage; exit 1 ;;
        esac
        ;;
esac
