next_free_host() {
    local t=$1 h used=" $(for p in $(peers $t); do pget $p ip4; done | sed 's/.*\.//' | tr '\n' ' ') "
    for h in $(seq 2 254); do
        case "$used" in *" $h "*) continue ;; esac
        echo "$h"; return
    done
}

# peer-add <tunnel> <name> [--ohne-psk]
cmd_peer_add() {
    local t="$1" name="$2" psk=1 h priv
    [ "$3" = "--ohne-psk" ] && psk=0
    uci -q get $CFG.t_$t >/dev/null || die "Tunnel $t gibt es nicht"
    valid_peer_name "$name" || die "Gerätename: 1–30 Zeichen A-Z, a-z, 0-9, _"
    uci -q get $CFG.p_$name >/dev/null && die "Gerät $name gibt es schon"
    uci -q get network.wg_peer_$name >/dev/null && die "network.wg_peer_$name existiert bereits"
    h=$(next_free_host $t); [ -n "$h" ] || die "Tunnel $t ist voll"
    wg genkey > $KEY_DIR/$name.priv
    wg pubkey < $KEY_DIR/$name.priv > $KEY_DIR/$name.pub
    [ $psk = 1 ] && wg genpsk > $KEY_DIR/$name.psk
    uci batch <<EOF
set $CFG.p_$name=peer
set $CFG.p_$name.tunnel='$t'
set $CFG.p_$name.public_key='$(cat $KEY_DIR/$name.pub)'
set $CFG.p_$name.ip4='$(vpn4_base $t).$h'
set $CFG.p_$name.ip6='$(vpn6_base $t)$h'
set $CFG.p_$name.keepalive='25'
set $CFG.p_$name.enabled='1'
set $CFG.p_$name.keyfile='$KEY_DIR/$name.priv'
EOF
    [ $psk = 1 ] && uci set $CFG.p_$name.pskfile="$KEY_DIR/$name.psk"
    uci commit $CFG
    ok "Gerät $name in Tunnel $t angelegt ($(vpn4_base $t).$h)."
    cmd_apply
}

cmd_peer_del() {
    local name="$1"
    uci -q get $CFG.p_$name >/dev/null || die "Gerät $name gibt es nicht"
    mkdir -p "$ARCHIV_DIR"
    mv -f $KEY_DIR/$name.priv $KEY_DIR/$name.pub $KEY_DIR/$name.psk "$ARCHIV_DIR/" 2>/dev/null
    uci delete $CFG.p_$name
    uci commit $CFG
    ok "Gerät $name gelöscht (Schlüssel in $ARCHIV_DIR)."
    cmd_apply
}

cmd_peer_enable() { # name 0|1
    uci -q get $CFG.p_$1 >/dev/null || die "Gerät $1 gibt es nicht"
    uci set $CFG.p_$1.enabled="$2"
    uci commit $CFG
    [ "$2" = 1 ] && ok "Gerät $1 entsperrt." || ok "Gerät $1 gesperrt (Schlüssel bleiben, Verbindung nicht mehr möglich)."
    cmd_apply
}

peer_allowed_ips() { # peer
    local t=$(pget $1 tunnel) n a list
    case "$(tget $t access)" in
        netz)
            list="$(vpn4_net $t), $(vpn6_net $t)"
            for n in $(tget $t network); do
                for a in $(net_field "$n" 3) $(net_field "$n" 4); do list="$list, $a"; done
            done
            echo "$list" ;;
        *) echo "0.0.0.0/0, ::/0" ;;
    esac
}

cmd_show() { # peer [--raw]
    local p="$1" t priv psk
    uci -q get $CFG.p_$p >/dev/null || die "Gerät $p gibt es nicht"
    t=$(pget $p tunnel)
    priv=$(pget $p keyfile); [ -n "$priv" ] && [ -s "$priv" ] && priv=$(cat "$priv") || priv="SCHLÜSSEL_NICHT_GESPEICHERT"
    psk=$(pget $p pskfile)
    if [ "$2" != "--raw" ]; then
        echo ""
        echo "========================================================"
        echo "   KONFIGURATION: $p   (Tunnel $t)"
        echo "========================================================"
    fi
    echo "[Interface]"
    echo "PrivateKey = $priv"
    echo "Address = $(pget $p ip4)/32, $(pget $p ip6)/128"
    echo "DNS = $(tget $t dns)"
    echo "MTU = $(tget $t mtu)"
    echo ""
    echo "[Peer]"
    echo "PublicKey = $(server_pub $t)"
    [ -n "$psk" ] && [ -s "$psk" ] && echo "PresharedKey = $(cat "$psk")"
    echo "Endpoint = $(endpoint_str $t)"
    echo "AllowedIPs = $(peer_allowed_ips $p)"
    echo "PersistentKeepalive = $(pget $p keepalive)"
    if [ "$2" != "--raw" ]; then
        echo "========================================================"
        echo "Als QR-Code für die WireGuard-App:  wg_manager qr $p"
    fi
}

# ---------------------------------------------------------------------------
#  QR-Code – eigener Erzeuger in awk, damit nichts nachinstalliert werden muss
#  (Byte-Modus, Fehlerkorrektur L, Ausgabe als UTF-8-Halbblöcke mit festen Farben)
# ---------------------------------------------------------------------------

qr_render() { # Text auf stdin -> QR-Code auf stdout
    awk '
function mul(a, b) { return (a == 0 || b == 0) ? 0 : EXP[(LOG[a] + LOG[b]) % 255] }
function bit(v, i) { return and(rshift(v, i), 1) }
function addbits(v, len,   i) { for (i = len - 1; i >= 0; i--) BIT[NB++] = bit(v, i) }
function rawmods(v,   r, na) {
    r = (16 * v + 128) * v + 64
    if (v >= 2) { na = int(v / 7) + 2; r -= (25 * na - 10) * na - 55; if (v >= 7) r -= 36 }
    return r
}
function setf(x, y, d) { V[y * S + x] = d ? 255 : 0; F[y * S + x] = 1 }
function finder(cx, cy,   dx, dy, d, x, y) {
    for (dy = -4; dy <= 4; dy++) for (dx = -4; dx <= 4; dx++) {
        x = cx + dx; y = cy + dy
        if (x < 0 || y < 0 || x >= S || y >= S) continue
        d = (dx < 0 ? -dx : dx); if ((dy < 0 ? -dy : dy) > d) d = (dy < 0 ? -dy : dy)
        setf(x, y, d != 2 && d != 4)
    }
}
function align(cx, cy,   dx, dy, d) {
    for (dy = -2; dy <= 2; dy++) for (dx = -2; dx <= 2; dx++) {
        d = (dx < 0 ? -dx : dx); if ((dy < 0 ? -dy : dy) > d) d = (dy < 0 ? -dy : dy)
        setf(cx + dx, cy + dy, d != 1)
    }
}
function wset(x, y, d) { W[y * S + x] = d; FP[NFP++] = y * S + x }
function format(mask,   data, rem, bits, i) {
    data = 8 + mask                        # Stufe L = 01
    rem = data
    for (i = 0; i < 10; i++) rem = xor(lshift(rem, 1), rshift(rem, 9) * 1335)
    bits = xor(lshift(data, 10) + rem, 21522)
    for (i = 0; i <= 5; i++) wset(8, i, bit(bits, i))
    wset(8, 7, bit(bits, 6)); wset(8, 8, bit(bits, 7)); wset(7, 8, bit(bits, 8))
    for (i = 9; i < 15; i++) wset(14 - i, 8, bit(bits, i))
    for (i = 0; i < 8; i++) wset(S - 1 - i, 8, bit(bits, i))
    for (i = 8; i < 15; i++) wset(8, S - 15 + i, bit(bits, i))
    wset(8, S - 8, 1)
}
# Strafpunkte Regel 1 + 3 einer Zeile/Spalte, bitweise für alle 8 Masken zugleich (V: Bit m = dunkel bei Maske m)
function scanline(o, st,   x, a, b, c, d, w) {
    for (x = 0; x < S; x++) L[x] = V[o + x * st]
    a = b = c = d = 0
    for (x = 1; x < S; x++) {                 # Läufe ≥ 5: je Fünfer-Fenster 1, je Lauf 2 dazu
        d = c; c = b; b = a; a = 255 - xor(L[x - 1], L[x])
        if (x >= 4 && (w = and(and(a, b), and(c, d)))) {
            HW[w]++
            if (x == 4) HS[w]++
            else if ((w = and(w, xor(L[x - 5], L[x - 4])))) HS[w]++
        }
    }
    for (x = 0; x + 6 < S; x++) {            # 1011101 mit 0000 davor oder danach
        if (!(c = and(L[x], 255 - L[x + 1]))) continue
        if (!(c = and(c, L[x + 2]))) continue
        if (!(c = and(and(c, L[x + 3]), and(L[x + 4], 255 - L[x + 5])))) continue
        if (!(c = and(c, L[x + 6]))) continue
        a = 0; for (w = x - 4; w < x; w++) if (w >= 0) a = or(a, L[w])
        b = 0; for (w = x + 7; w < x + 11; w++) if (w < S) b = or(b, L[w])
        if ((c = and(c, or(255 - a, 255 - b)))) HF[c]++
    }
}
function bestmask(   x, y, i, o, e, v, m, pm, p, best, bm, dark) {
    for (y = 0; y < S; y++) { scanline(y * S, 1); scanline(y, S) }
    for (y = 0; y < S; y++) {
        o = y * S
        for (x = 0; x < S; x++) {
            HD[V[o + x]]++
            if (x && y) {                         # 2x2 gleicher Farbe
                v = V[o + x]
                e = and(and(255 - xor(v, V[o + x - 1]), 255 - xor(v, V[o - S + x])), 255 - xor(v, V[o - S + x - 1]))
                if (e) H2[e]++
            }
        }
    }
    best = -1; pm = 1
    for (m = 0; m < 8; m++) {
        p = 0; dark = 0
        for (v in HW) if (int(v / pm) % 2) p += HW[v]
        for (v in HS) if (int(v / pm) % 2) p += 2 * HS[v]
        for (v in H2) if (int(v / pm) % 2) p += 3 * H2[v]
        for (v in HF) if (int(v / pm) % 2) p += 40 * HF[v]
        for (v in HD) if (int(v / pm) % 2) dark += HD[v]
        x = dark * 100 / (S * S) - 50; if (x < 0) x = -x
        p += int(x / 5) * 10
        if (best < 0 || p < best) { best = p; bm = m }
        pm *= 2
    }
    return bm
}
function px(x, y) { return (x < 0 || y < 0 || x >= S || y >= S) ? 0 : W[y * S + x] }

BEGIN {
    for (i = 1; i < 128; i++) ORD[sprintf("%c", i)] = i
    x = 1
    for (i = 0; i < 255; i++) { EXP[i] = x; LOG[x] = i; x *= 2; if (x > 255) x = xor(x, 285) }
    split("7 10 15 20 26 18 20 24 30 18 20 24 26 30 22 24 28 30 28 28 28 28 30 30 26 28 30 30 30 30 30 30 30 30 30 30 30 30 30 30", ECC, " ")
    split("1 1 1 1 1 2 2 2 2 4 4 4 4 4 6 6 6 6 7 8 8 9 9 10 12 12 12 13 14 15 16 17 18 19 19 20 21 22 24 25", BLK, " ")
    n = 0
}
{
    if (NR > 1) D[n++] = 10
    for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (!(c in ORD)) { print "QR-Code: nur ASCII-Text möglich" > "/dev/stderr"; err = 1; exit 1 }
        D[n++] = ORD[c]
    }
}
END {
    if (err) exit 1
    for (v = 1; v <= 40; v++) {
        cap = int(rawmods(v) / 8) - ECC[v] * BLK[v]
        if (4 + (v < 10 ? 8 : 16) + 8 * n <= cap * 8) break
    }
    if (v > 40) { print "QR-Code: Text zu lang" > "/dev/stderr"; exit 1 }
    S = 4 * v + 17

    # Datenbits
    NB = 0
    addbits(4, 4); addbits(n, v < 10 ? 8 : 16)
    for (i = 0; i < n; i++) addbits(D[i], 8)
    for (i = 0; i < 4 && NB < cap * 8; i++) BIT[NB++] = 0
    while (NB % 8) BIT[NB++] = 0
    for (i = 0; i < cap; i++) {
        if (i * 8 < NB) { b = 0; for (j = 0; j < 8; j++) b = b * 2 + BIT[i * 8 + j]; CW[i] = b }
        else CW[i] = ((i - NB / 8) % 2) ? 17 : 236
    }

    # Fehlerkorrektur je Block, dann verschränken
    ecl = ECC[v]; nbl = BLK[v]; raw = int(rawmods(v) / 8)
    nshort = nbl - raw % nbl; slen = int(raw / nbl)
    for (i = 0; i < ecl; i++) G[i] = 0
    G[ecl - 1] = 1; root = 1
    for (i = 0; i < ecl; i++) {
        for (j = 0; j < ecl; j++) { G[j] = mul(G[j], root); if (j + 1 < ecl) G[j] = xor(G[j], G[j + 1]) }
        root = mul(root, 2)
    }
    for (j = 0; j < ecl; j++) LG[j] = G[j] ? LOG[G[j]] : -1
    k = 0
    for (b = 0; b < nbl; b++) {
        DL[b] = slen - ecl + (b < nshort ? 0 : 1)
        for (j = 0; j < ecl; j++) R[j] = 0
        for (i = 0; i < DL[b]; i++) {
            BD[b, i] = CW[k++]
            f = xor(BD[b, i], R[0])
            if (f == 0) { for (j = 0; j < ecl - 1; j++) R[j] = R[j + 1]; R[ecl - 1] = 0; continue }
            lf = LOG[f]
            for (j = 0; j < ecl - 1; j++) R[j] = (LG[j] < 0) ? R[j + 1] : xor(R[j + 1], EXP[(LG[j] + lf) % 255])
            R[ecl - 1] = (LG[ecl - 1] < 0) ? 0 : EXP[(LG[ecl - 1] + lf) % 255]
        }
        for (j = 0; j < ecl; j++) BE[b, j] = R[j]
    }
    k = 0
    for (i = 0; i <= slen - ecl; i++) for (b = 0; b < nbl; b++) if (i < DL[b]) OUT[k++] = BD[b, i]
    for (i = 0; i < ecl; i++) for (b = 0; b < nbl; b++) OUT[k++] = BE[b, i]

    # Feste Muster
    for (i = 0; i < S; i++) { setf(6, i, i % 2 == 0); setf(i, 6, i % 2 == 0) }
    finder(3, 3); finder(S - 4, 3); finder(3, S - 4)
    if (v > 1) {
        na = int(v / 7) + 2; step = int((v * 8 + na * 3 + 5) / (na * 4 - 4)) * 2
        P[0] = 6; p = S - 7
        for (i = na - 1; i >= 1; i--) { P[i] = p; p -= step }
        for (i = 0; i < na; i++) for (j = 0; j < na; j++)
            if (!((i == 0 && j == 0) || (i == 0 && j == na - 1) || (i == na - 1 && j == 0))) align(P[i], P[j])
    }
    for (i = 0; i < 9; i++) if (i != 6) { setf(8, i, 0); setf(i, 8, 0) }   # Platz für Formatangaben
    for (i = 0; i < 8; i++) { setf(S - 1 - i, 8, 0); setf(8, S - 1 - i, 0) }
    if (v >= 7) {
        rem = v
        for (i = 0; i < 12; i++) rem = xor(lshift(rem, 1), rshift(rem, 11) * 7973)
        bits = lshift(v, 12) + rem
        for (i = 0; i < 18; i++) { a = S - 11 + i % 3; b = int(i / 3); setf(a, b, bit(bits, i)); setf(b, a, bit(bits, i)) }
    }

    # Daten im Zickzack eintragen; MT: Bit m = Feld dunkel bei Maske m (Muster wiederholt sich alle 6 Spalten, 12 Zeilen)
    for (x = 0; x < 6; x++) for (y = 0; y < 12; y++) {
        a = x * y % 2; c = x * y % 3
        MT[x * 12 + y] = ((x + y) % 2 == 0) + 2 * (y % 2 == 0) + 4 * (x % 3 == 0) + 8 * ((x + y) % 3 == 0) + 16 * ((int(x / 3) + int(y / 2)) % 2 == 0) + 32 * (a + c == 0) + 64 * ((a + c) % 2 == 0) + 128 * (((x + y) % 2 + c) % 2 == 0)
    }
    total = k * 8
    for (i = 0; i < k; i++) { b = OUT[i]; for (j = 7; j >= 0; j--) { BB[i * 8 + j] = b % 2; b = int(b / 2) } }
    i = 0
    for (right = S - 1; right >= 1; right -= 2) {
        if (right == 6) right = 5
        up = (and(right + 1, 2) == 0)
        for (vert = 0; vert < S; vert++) for (j = 0; j < 2; j++) {
            x = right - j; y = up ? S - 1 - vert : vert; idx = y * S + x
            if (F[idx]) continue
            mb = MT[x % 6 * 12 + y % 12]
            V[idx] = (i < total && BB[i]) ? 255 - mb : mb; i++
        }
    }

    # Alle 8 Masken als Bits je Feld, beste wählen
    pm = 1
    for (m = 0; m < 8; m++) {
        NFP = 0; format(m)
        for (i = 0; i < NFP; i++) { idx = FP[i]; if (m == 0) V[idx] = 0; V[idx] += W[idx] * pm }
        pm *= 2
    }
    pm = 2 ^ bestmask()
    for (i = 0; i < S * S; i++) W[i] = int(V[i] / pm) % 2

    # Ausgabe: hell = weiß, je Zeichen zwei Zeilen
    q = 2
    for (y = -q; y < S + q; y += 2) {
        line = "\033[40;97m"
        for (x = -q; x < S + q; x++) {
            t = px(x, y); u = px(x, y + 1)
            line = line (t ? (u ? " " : "\342\226\204") : (u ? "\342\226\200" : "\342\226\210"))
        }
        print line "\033[0m"
    }
}'
}

cmd_qr() { # gerät
    local p="$1" kf
    uci -q get $CFG.p_$p >/dev/null || die "Gerät $p gibt es nicht"
    kf=$(pget $p keyfile)
    [ -n "$kf" ] && [ -s "$kf" ] || die "Für $p ist kein privater Schlüssel gespeichert – kein QR-Code möglich."
    echo "QR-Code wird berechnet (dauert einige Sekunden) …" >&2
    cmd_show "$p" --raw | grep . | qr_render || die "QR-Code konnte nicht erzeugt werden."
    echo "WireGuard-App: „+“ → „QR-Code scannen“. Ist das Bild verzerrt: Fenster größer ziehen oder Schrift verkleinern."
}

