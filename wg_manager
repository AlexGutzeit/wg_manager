human_bytes() { awk -v b="$1" 'BEGIN{split("B KiB MiB GiB TiB",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++};f=(i==1)?"%d %s":"%.1f %s";printf f,b,u[i]}'; }
ago() {
    local s=$1 now=$(date +%s)
    [ "$s" = 0 ] && { echo "nie"; return; }
    s=$((now - s))
    if [ $s -lt 120 ]; then echo "vor $s s"
    elif [ $s -lt 7200 ]; then echo "vor $((s/60)) min"
    elif [ $s -lt 172800 ]; then echo "vor $((s/3600)) h"
    else echo "vor $((s/86400)) Tagen"; fi
}

cmd_nets() {
    local i=0
    say "Netze dieses Routers (Client-Netze und WAN – Babel-, Mesh- und Tunnelschnittstellen sind ausgeschlossen):"
    nets_detect | while IFS='|' read -r name dev v4 v6; do
        i=$((i+1))
        printf "  %-12s %-10s %-20s %s\n" "$name" "$dev" "${v4:--}" "${v6:--}"
    done
}

cmd_list() {
    local t p ifn st dump line pub hs rx tx ep
    [ -n "$(tunnels)$(babels)$(netlinks)" ] || { say "Noch keine Tunnel. (Altbestand übernehmen: wg_manager migrate)"; return; }
    for t in $(tunnels); do
        ifn=$(tget $t ifname)
        ip link show "$ifn" >/dev/null 2>&1 && st="${GREEN}aktiv${NC}" || st="${RED}aus${NC}"
        say "${BLUE}Tunnel $t${NC} ($ifn, $st) – Port $(tget $t port), $(vpn4_net $t) $(vpn6_net $t)"
        say "  Netz: $(tget $t network | sed 's/^$/–/')   Zugriff: $(tget $t access)   Verwaltung: $( [ "$(tget $t admin)" = 1 ] && echo ja || echo nein )   Freifunk-Netze: $( [ "$(tget $t freifunk)" = 1 ] && echo ja || echo nein )   MTU: $(tget $t mtu)   DNS: $(tget $t dns)"
        dump=$(wg show "$ifn" dump 2>/dev/null | tail -n +2)
        for p in $(peers $t); do
            pub=$(pget $p public_key)
            line=$(echo "$dump" | awk -v k="$pub" '$1==k')
            hs=$(echo "$line" | awk '{print $5}'); rx=$(echo "$line" | awk '{print $6}'); tx=$(echo "$line" | awk '{print $7}')
            ep=$(echo "$line" | awk '{print $3}')
            if [ "$(pget $p enabled)" = 0 ]; then
                printf "    %-16s %-14s %b\n" "$p" "$(pget $p ip4)" "${YEL}gesperrt${NC}"
            else
                printf "    %-16s %-14s zuletzt %-14s ↓%s ↑%s %s\n" "$p" "$(pget $p ip4)" "$(ago ${hs:-0})" "$(human_bytes ${rx:-0})" "$(human_bytes ${tx:-0})" "$( [ "$ep" != "(none)" ] && echo "$ep")"
            fi
        done
    done
    [ -n "$(babels)" ] && say "${BLUE}Babel-Verbindungen (Router ↔ Router)${NC}"
    if [ -n "$(babels)" ] && [ -d /etc/bird/fff ] && ! pidof bird >/dev/null; then
        say "  ${RED}ACHTUNG: bird läuft nicht – kein Babel, keine Routen!${NC} Starten: wg_manager babel-pruefen (macht der Wächter auch jede Minute)"
    fi
    for t in $(babels); do
        ifn=$(bget $t ifname)
        if [ "$(bget $t role)" = a ]; then st="Seite A, Port $(bget $t port)"
        else st="Seite B → $(bget $t von) [$(bget $t endpoint_host)]:$(bget $t endpoint_port)"; fi
        hs=$(babel_hs "$ifn")
        say "  $t ($ifn, $st)"
        if babel_connected "$ifn"; then
            ep=$(babel_reach "$ifn" "$(babel_peer_ll $t)" && echo ja || echo nein)
            say "    ${GREEN}verbunden${NC} (zuletzt $(ago ${hs:-0}))   Gegenstelle antwortet: $ep   Babel-Routen: $(babel_routes "$ifn")   MTU: $(bget $t mtu)   rxcost: $(bget $t rxcost)"
        else
            say "    ${RED}nicht verbunden${NC} (zuletzt $(ago ${hs:-0}))   MTU: $(bget $t mtu)   rxcost: $(bget $t rxcost)"
        fi
    done
    [ -n "$(netlinks)" ] && say "${BLUE}Netzverbindungen (Netz → Netz)${NC}"
    for t in $(netlinks); do
        ifn=$(lget $t ifname)
        if [ "$(lget $t role)" = a ]; then
            say "  $t ($ifn, Seite A, Port $(lget $t port)) – gibt $(lget $t netz) $(lget $t real) frei (Ersatznetz $(lget $t ersatz))"
            line=$(net_field "$(lget $t netz)" 3 | awk '{print $1}')
            [ "$line" = "$(lget $t real)" ] || say "    ${YEL}Achtung: $(lget $t netz) ist jetzt ${line:-nicht da} – Verbindung neu anlegen.${NC}"
        else
            say "  $t ($ifn, Seite B → $(lget $t von) [$(lget $t endpoint_host)]:$(lget $t endpoint_port)) – aus $(echo $(lget $t netz)) nach $(lget $t dest)$( [ "$(lget $t dest)" != "$(lget $t real)" ] && echo " (= $(lget $t real) dort)")"
        fi
        hs=$(babel_hs "$ifn")
        line=$(wg show "$ifn" transfer 2>/dev/null | awk '{print $2, $3}' | head -1)
        if babel_connected "$ifn"; then
            say "    ${GREEN}verbunden${NC} (zuletzt $(ago ${hs:-0}))   ↓$(human_bytes ${line%% *}) ↑$(human_bytes ${line##* })"
        else
            say "    ${RED}nicht verbunden${NC} (zuletzt $(ago ${hs:-0}))"
        fi
    done
}

