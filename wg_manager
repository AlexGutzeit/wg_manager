menu_links() {
    local c n name netz
    echo "Netzverbindungen – ein Netz eines anderen Routers aus einem Netz dieses Routers erreichen"
    echo "  (z. B. den Drucker hinter der Fritzbox eines anderen Freifunk-Routers aus dem eigenen Heimnetz)"
    echo "  1) Netz freigeben (dieser Router lauscht, gibt eine Zeile zum Einfügen aus)"
    echo "  2) Zeile vom anderen Router einfügen (verbindet sich, prüft auf gleiche Netze)"
    echo "  3) Zeile erneut anzeigen   4) Netzverbindung löschen"
    printf "Auswahl: "; read -r c
    case "$c" in
        1) printf "Name der Verbindung (a-z, 0-9, max. 12, z. B. drucker): "; read -r name
           netz=$(choose_from "Welches Netz freigeben?" "$(nets_detect | cut -d'|' -f1,3 | tr '|' ' ')") || return
           ( cmd_link_add "$name" --netz "${netz%% *}" ) ;;
        2) ( cmd_link_insert ) ;;
        3) n=$(choose_from "Welche Verbindung?" "$(for n in $(netlinks); do [ "$(lget $n role)" = a ] && echo $n; done)") && ( cmd_link_show "$n" ) ;;
        4) n=$(choose_from "Welche Verbindung löschen?" "$(netlinks)") && { printf "%s wirklich löschen? [j/N]: " "$n"; read -r c; [ "$c" = j ] && ( cmd_link_del "$n" ); } ;;
    esac
}

menu_classic() { # Zahlenmenü – ohne Terminal oder auf Wunsch (wg_manager menue-einfach)
    local c t p name
    while true; do
        clear
        echo "========================================"
        echo "   WireGuard-Verwaltung  ($(uci -q get fff.system.hostname || hostname))"
        echo "========================================"
