human_bytes() { awk -v b="$1" 'BEGIN{split("B KiB MiB GiB TiB",u," ");i=1;while(b>=1024&&i<5){b/=1024;i++};f=(i==1)?"%d %s":"%.1f %s";printf f,b,u[i]}'; }
ago() {
    local s=$1 now=$(date +%s)
    [ "$s" = 0 ] && { echo "nie"; return; }
    s=$((now - s))
    if [ $s -lt 120 ]; then echo "vor $s s"
    elif [ $s -lt 7200 ]; then echo "vor $((s/60)) min"
    elif [ $s -lt 172800 ]; then echo "vor $((s/3600)) h"
    else echo "vor $((s/86400)) Tagen"; fi
}

cmd_nets() {
    local i=0
    say "Netze dieses Routers (zum Einhängen eines Tunnels):"
    nets_detect | while IFS='|' read -r name dev v4 v6; do
        i=$((i+1))
        printf "  %-12s %-10s %-20s %s\n" "$name" "$dev" "${v4:--}" "${v6:--}"
    done
}

cmd_list() {
    local t p ifn st dump line pub hs rx tx ep
    [ -n "$(tunnels)$(babels)" ] || { say "Noch keine Tunnel. (Altbestand übernehmen: wg_manager migrate)"; return; }
    for t in $(tunnels); do
        ifn=$(tget $t ifname)
        ip link show "$ifn" >/dev/null 2>&1 && st="${GREEN}aktiv${NC}" || st="${RED}aus${NC}"
        say "${BLUE}Tunnel $t${NC} ($ifn, $st) – Port $(tget $t port), $(vpn4_net $t) $(vpn6_net $t)"
        say "  Netz: $(tget $t network | sed 's/^$/–/')   Zugriff: $(tget $t access)   Verwaltung: $( [ "$(tget $t admin)" = 1 ] && echo ja || echo nein )   Freifunk-Netze: $( [ "$(tget $t freifunk)" = 1 ] && echo ja || echo nein )   MTU: $(tget $t mtu)   DNS: $(tget $t dns)"
        dump=$(wg show "$ifn" dump 2>/dev/null | tail -n +2)
        for p in $(peers $t); do
            pub=$(pget $p public_key)
            line=$(echo "$dump" | awk -v k="$pub" '$1==k')
            hs=$(echo "$line" | awk '{print $5}'); rx=$(echo "$line" | awk '{print $6}'); tx=$(echo "$line" | awk '{print $7}')
            ep=$(echo "$line" | awk '{print $3}')
            if [ "$(pget $p enabled)" = 0 ]; then
                printf "    %-16s %-14s %b\n" "$p" "$(pget $p ip4)" "${YEL}gesperrt${NC}"
            else
                printf "    %-16s %-14s zuletzt %-14s ↓%s ↑%s %s\n" "$p" "$(pget $p ip4)" "$(ago ${hs:-0})" "$(human_bytes ${rx:-0})" "$(human_bytes ${tx:-0})" "$( [ "$ep" != "(none)" ] && echo "$ep")"
            fi
        done
    done
    [ -n "$(babels)" ] && say "${BLUE}Babel-Verbindungen (Router ↔ Router)${NC}"
    for t in $(babels); do
        ifn=$(bget $t ifname)
        if [ "$(bget $t role)" = a ]; then st="Seite A, Port $(bget $t port)"
        else st="Seite B → $(bget $t von) [$(bget $t endpoint_host)]:$(bget $t endpoint_port)"; fi
        hs=$(babel_hs "$ifn")
        say "  $t ($ifn, $st)"
        if babel_connected "$ifn"; then
            ep=$(babel_reach "$ifn" "$(babel_peer_ll $t)" && echo ja || echo nein)
            say "    ${GREEN}verbunden${NC} (zuletzt $(ago ${hs:-0}))   Gegenstelle antwortet: $ep   Babel-Routen: $(babel_routes "$ifn")   MTU: $(bget $t mtu)"
        else
            say "    ${RED}nicht verbunden${NC} (zuletzt $(ago ${hs:-0}))   MTU: $(bget $t mtu)"
        fi
    done
}

# ---------------------------------------------------------------------------
#  Übernahme des Altbestands (wg_manager v1 / privwg)
# ---------------------------------------------------------------------------

# migrate [--dns "..."]
cmd_migrate() {
    local ifn t key k found p a4 a6 dns="" mss="" net=""
    [ "$1" = "--dns" ] && dns="$2"
    ensure_env
    [ -n "$(tunnels)" ] && die "Es gibt bereits Tunnel in $CFG_FILE – Übernahme nur einmal."
    for ifn in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.proto='wireguard'$/\1/p"); do
        # nur selbst angelegte Zugänge (Geräte als wg_peer_*), keine Freifunk-Uplinks
        uci -q show network | grep -q "^network\.wg_peer_[^.=]*=wireguard_$ifn$" || continue
        t=${ifn#wg_}
        valid_tunnel_name "$t" || die "Name $ifn passt nicht ins Schema – bitte von Hand übernehmen"
        k=$(uci get network.$ifn.private_key)
        found=""
        for key in $KEY_DIR/*.key; do
            [ -f "$key" ] && [ "$(tr -d '\n' < "$key")" = "$k" ] && { found=$key; break; }
        done
        [ -n "$found" ] || { found=$KEY_DIR/${t}_server.key; echo "$k" > "$found"; }
        a4=""; a6=""
        for a in $(uci get network.$ifn.addresses); do case "$a" in *:*) a6=$a ;; *) a4=$a ;; esac; done
        uci -q get network.client >/dev/null && net=client
        uci batch <<EOF
set $CFG.t_$t=tunnel
set $CFG.t_$t.ifname='$ifn'
set $CFG.t_$t.port='$(uci get network.$ifn.listen_port)'
set $CFG.t_$t.ip4='$a4'
set $CFG.t_$t.ip6='$a6'
set $CFG.t_$t.mtu='$(uci -q get network.$ifn.mtu || echo 1280)'
set $CFG.t_$t.access='beides'
set $CFG.t_$t.admin='1'
set $CFG.t_$t.freifunk='1'
set $CFG.t_$t.dns='${dns:-${a4%/*}}'
set $CFG.t_$t.keyfile='$found'
EOF
        [ -n "$net" ] && uci add_list $CFG.t_$t.network="$net"
        for p in $(uci -q show network | sed -n "s/^network\.wg_peer_\([^.=]*\)=wireguard_$ifn$/\1/p"); do
            a4=""; a6=""
            for a in $(uci get network.wg_peer_$p.allowed_ips); do case "$a" in *:*) a6=${a%/*} ;; *) a4=${a%/*} ;; esac; done
            uci batch <<EOF
set $CFG.p_$p=peer
set $CFG.p_$p.tunnel='$t'
set $CFG.p_$p.public_key='$(uci get network.wg_peer_$p.public_key)'
set $CFG.p_$p.ip4='$a4'
set $CFG.p_$p.ip6='$a6'
set $CFG.p_$p.keepalive='$(uci -q get network.wg_peer_$p.persistent_keepalive || echo 25)'
set $CFG.p_$p.enabled='1'
EOF
            [ -s $KEY_DIR/$p.priv ] && uci set $CFG.p_$p.keyfile="$KEY_DIR/$p.priv"
            k=$(uci -q get network.wg_peer_$p.preshared_key)
            [ -n "$k" ] && { echo "$k" > $KEY_DIR/$p.psk; uci set $CFG.p_$p.pskfile="$KEY_DIR/$p.psk"; }
        done
        ok "Übernommen: Tunnel $t ($ifn) mit Geräten: $(peers $t | tr '\n' ' ')"
    done
    [ -n "$(tunnels)" ] || die "Kein Altbestand gefunden."
    # privwg hat alle weitergeleiteten TCP-Verbindungen auf MSS 1240 begrenzt – bleibt vorerst so
    grep -q 'maxseg size set 1240' /usr/sbin/privwg $NFT_FILE 2>/dev/null && mss=1240
    [ -n "$mss" ] && uci set $CFG.settings.mss_clamp_all="$mss"
    uci commit $CFG
    # Altlasten: von Hand gesetzte Regeln (privwg), alte nft-Tabelle, Start über rc.local
    for t in $(tunnels); do
        ip rule del to "$(vpn4_net $t)" lookup main priority 10 2>/dev/null
        ip -6 rule del to "$(vpn6_net $t)" lookup main priority 10 2>/dev/null
        ip rule del iif "$(tget $t ifname)" lookup fff priority 31 2>/dev/null
        ip -6 rule del iif "$(tget $t ifname)" lookup fff priority 31 2>/dev/null
    done
    if [ -f "$NFT_FILE" ] && grep -q 'table inet wireguard_custom' "$NFT_FILE"; then
        cp "$NFT_FILE" /root/nftables-fff.conf.vor-wg_manager2
        awk '/^# WireGuard-Zugang wg_home/{skip=1} /^table inet wireguard_custom/{skip=1} !skip{print} skip && /^}/{skip=0}' /root/nftables-fff.conf.vor-wg_manager2 > "$NFT_FILE"
    fi
    nft delete table inet wireguard_custom 2>/dev/null
    sed -i '/\/usr\/sbin\/privwg/d' /etc/rc.local
    cmd_apply
}

# ---------------------------------------------------------------------------
#  Menü
# ---------------------------------------------------------------------------

pause() { printf "\nWeiter mit Enter … "; read -r _; }

menu_show() { # gerät: Konfiguration zeigen, auf Wunsch als QR-Code
    local a
    ( cmd_show "$1" ) || return
    printf "\nAls QR-Code anzeigen? [J/n]: "; read -r a
    case "$a" in n|N) ;; *) ( cmd_qr "$1" ) ;; esac
}

choose_from() { # Titel, Liste (Zeilen) -> Auswahl auf stdout, Dialog auf stderr
    local title="$1" list="$2" i=0 n choice
    n=$(echo "$list" | grep -c .)
    [ "$n" = 0 ] && return 1
    [ "$n" = 1 ] && { echo "$list"; return 0; }
    echo "$title" >&2
    echo "$list" | while read -r l; do i=$((i+1)); printf "  %d) %s\n" "$i" "$l" >&2; done
    printf "Nummer: " >&2; read -r choice
    case "$choice" in ''|*[!0-9]*) return 1 ;; esac
    echo "$list" | sed -n "${choice}p" | grep .
}

choose_nets() { # -> Netznamen (leer = keins)
    local list choice out="" i=0 n
    list=$(nets_detect)
    echo "Vorhandene Netze auf diesem Router:" >&2
    echo "$list" | while IFS='|' read -r name dev v4 v6; do
        i=$((i+1)); printf "  %d) %-12s %-10s %-20s %s\n" "$i" "$name" "$dev" "${v4:--}" "${v6:--}" >&2
    done
    printf "Nummer(n), mehrere mit Leerzeichen, 0 = kein Netz: " >&2; read -r choice
    for n in $choice; do
        case "$n" in 0|*[!0-9]*) continue ;; esac
        out="$out $(echo "$list" | sed -n "${n}p" | cut -d'|' -f1)"
    done
    echo $out
}

choose_access() {
    local c
    echo "Was dürfen Geräte in diesem Tunnel?" >&2
    echo "  1) Netz + Internet (alles über den Tunnel)" >&2
    echo "  2) nur das gewählte Netz (Internet läuft am Gerät normal)" >&2
    echo "  3) nur Internet (Gäste – keine Geräte im Haus erreichbar)" >&2
    printf "Auswahl [1]: " >&2; read -r c
    case "$c" in 2) echo netz ;; 3) echo internet ;; *) echo beides ;; esac
}

choose_mtu() { # -> MTU (Dialog auf stderr)
    local m s
    echo "MTU des Tunnels = Strecke des Routers ins Internet minus $WG_OVERHEAD:" >&2
    echo "  Freifunk über DSL-Gateway 1412 → 1332 · Richtfunk/Glasfaser direkt 1500 → 1420 · im Zweifel $MTU_DEFAULT" >&2
    echo "  Messe die Strecke …" >&2
    m=$(path_mtu)
    if [ -n "$m" ]; then s=$(mtu_of_path $m); echo "  Gemessen: $m → Vorschlag $s" >&2
    else s=$MTU_DEFAULT; echo "  Nicht messbar → Vorschlag $s" >&2; fi
    printf "MTU [%s]: " "$s" >&2; read -r m
    echo "${m:-$s}"
}

menu_tunnel_add() {
    local name netz acc admin a mtu
    printf "Name des neuen Tunnels (a-z, 0-9, max. 12): "; read -r name
    netz=$(choose_nets)
    acc=$(choose_access)
    [ "$acc" != "internet" ] && [ -z "$netz" ] && { echo "Dafür muss ein Netz gewählt werden."; return; }
    printf "Dürfen Geräte die Router-Verwaltung erreichen (SSH/Web)? [j/N]: "; read -r a
    case "$a" in j|J) admin=1 ;; *) admin=0 ;; esac
    mtu=$(choose_mtu)
    ( cmd_tunnel_add "$name" --netz "$netz" --zugriff "$acc" --admin "$admin" --mtu "$mtu" )
}

menu_tunnel_edit() {
    local t c
    t=$(choose_from "Welcher Tunnel?" "$(tunnels)") || return
    echo "Tunnel $t: Netz=$(tget $t network) Zugriff=$(tget $t access) Verwaltung=$(tget $t admin) DNS=$(tget $t dns) MTU=$(tget $t mtu)"
    echo "  1) Netz ändern   2) Zugriff ändern   3) Router-Verwaltung an/aus   4) DNS ändern   5) Freifunk-Netze an/aus"
    echo "  6) MTU ändern"
    printf "Auswahl: "; read -r c
    case "$c" in
        1) ( cmd_tunnel_edit "$t" --netz "$(choose_nets)" ) ;;
        2) ( cmd_tunnel_edit "$t" --zugriff "$(choose_access)" ) ;;
        3) ( cmd_tunnel_edit "$t" --admin "$( [ "$(tget $t admin)" = 1 ] && echo 0 || echo 1 )" ) ;;
        5) ( cmd_tunnel_edit "$t" --freifunk "$( [ "$(tget $t freifunk)" = 1 ] && echo 0 || echo 1 )" ) ;;
        4) printf "DNS (z. B. %s): " "$(tget $t ip4 | cut -d/ -f1)"; read -r c; [ -n "$c" ] && ( cmd_tunnel_edit "$t" --dns "$c" ) ;;
        6) ( cmd_tunnel_edit "$t" --mtu "$(choose_mtu)" ) ;;
    esac
}

menu_babel() {
    local c b name
    echo "Babel-Verbindungen – zwei Freifunk-Router über WireGuard und Babel koppeln"
    echo "  1) Babel-Tunnel konfigurieren (dieser Router lauscht, gibt eine Zeile zum Einfügen aus)"
    echo "  2) Babel-Tunnel einfügen (Zeile vom anderen Router)"
    echo "  3) Zeile erneut anzeigen   4) MTU neu aushandeln   5) Babel-Tunnel löschen"
    printf "Auswahl: "; read -r c
    case "$c" in
        1) printf "Name der Verbindung (a-z, 0-9, max. 12, z. B. lte1): "; read -r name; ( cmd_babel_add "$name" ) ;;
        2) ( cmd_babel_insert ) ;;
        3) b=$(choose_from "Welche Verbindung?" "$(for b in $(babels); do [ "$(bget $b role)" = a ] && echo $b; done)") && ( cmd_babel_show "$b" ) ;;
        4) b=$(choose_from "Welche Verbindung?" "$(babels)") && ( cmd_babel_mtu "$b" ) ;;
        5) b=$(choose_from "Welche Verbindung löschen?" "$(babels)") && { printf "%s wirklich löschen? [j/N]: " "$b"; read -r c; [ "$c" = j ] && ( cmd_babel_del "$b" ); } ;;
    esac
}

menu() {
    local c t p name
    while true; do
        clear
        echo "========================================"
        echo "   WireGuard-Verwaltung  ($(uci -q get fff.system.hostname || hostname))"
        echo "========================================"
        cmd_list
        echo "----------------------------------------"
        echo " 1) Gerät hinzufügen        5) Neuen Tunnel anlegen"
        echo " 2) Gerätekonfig + QR-Code  6) Tunnel bearbeiten (Netz/Zugriff)"
        echo " 3) Gerät sperren/entsperren 7) Tunnel löschen"
        echo " 4) Gerät löschen           8) Netze anzeigen"
        echo " 9) Alles neu anwenden (reparieren)   0) Beenden"
        echo " b) Babel-Verbindungen (Router ↔ Router)"
        printf "Auswahl: "; read -r c
        case "$c" in
            1) t=$(choose_from "In welchen Tunnel?" "$(tunnels)") || { pause; continue; }
               printf "Name des Geräts (z. B. Handy_Alex): "; read -r name
               ( cmd_peer_add "$t" "$name" ) && menu_show "$name"; pause ;;
            2) p=$(choose_from "Welches Gerät?" "$(peers)") && menu_show "$p"; pause ;;
            3) p=$(choose_from "Welches Gerät?" "$(peers)") && ( cmd_peer_enable "$p" "$( [ "$(pget $p enabled)" = 0 ] && echo 1 || echo 0 )" ); pause ;;
            4) p=$(choose_from "Welches Gerät löschen?" "$(peers)") && { printf "%s wirklich löschen? [j/N]: " "$p"; read -r name; [ "$name" = j ] && ( cmd_peer_del "$p" ); }; pause ;;
            5) menu_tunnel_add; pause ;;
            6) menu_tunnel_edit; pause ;;
            7) t=$(choose_from "Welchen Tunnel löschen?" "$(tunnels)") && { printf "Tunnel %s mit allen Geräten löschen? [j/N]: " "$t"; read -r name; [ "$name" = j ] && ( cmd_tunnel_del "$t" ); }; pause ;;
            8) cmd_nets; pause ;;
            9) ( cmd_apply ); pause ;;
            b|B) menu_babel; pause ;;
            0|q) exit 0 ;;
        esac
    done
}

usage() {
    cat <<EOF
wg_manager – WireGuard-Zugänge verwalten (ohne Argumente: Menü)

  liste                              Tunnel und Geräte mit Status
  netze                              Netze des Routers, in die man einhängen kann
  zeige <gerät> [--raw]              Gerätekonfiguration (--raw: nur die Datei)
  qr <gerät>                         Gerätekonfiguration als QR-Code für die WireGuard-App
  geraet-neu <tunnel> <name> [--ohne-psk]
  geraet-sperren <name> | geraet-entsperren <name> | geraet-loeschen <name>
  tunnel-neu <name> [--netz "client ..."] [--zugriff beides|netz|internet] [--admin 0|1] [--freifunk 0|1] [--port N] [--dns "..."] [--mtu N|auto]
  tunnel-aendern <name> [--netz "..."] [--zugriff ...] [--admin 0|1] [--freifunk 0|1] [--dns "..."] [--mtu N|auto]
  mtu-messen [ziel]                  Strecke des Routers ins Internet messen, passende Tunnel-MTU vorschlagen
                                     (MTU $MTU_MIN–$MTU_MAX, ohne Angabe $MTU_DEFAULT; auto = gemessen; DSL 1412 → 1332, 1500 → 1420)
  tunnel-loeschen <name>
  apply [-q]                         alles aus /etc/config/wgmanager neu anwenden

Babel-Verbindungen (zwei Freifunk-Router koppeln, z. B. einen Router hinter LTE):
  babel-neu <name> [--port N] [--rxcost N]
                                     Seite A: lauscht auf ihrer Freifunk-IPv6, gibt eine Zeile zum Einfügen aus
  babel-einfuegen ["<zeile>"] [--name N] [--rxcost N]
                                     Seite B: Zeile von A einfügen (ohne Angabe: wird abgefragt), verbindet sich
  babel-zeige <name>                 Zeile erneut ausgeben (Seite A)
  babel-mtu <name>                   MTU jetzt neu aushandeln
  babel-loeschen <name>
  babel-pruefen [-q]                 Wächter (cron, alle 5 min): stellt Fehlendes wieder her, handelt die MTU aus
  migrate [--dns "..."]              Altbestand (wg_manager v1/privwg) übernehmen
EOF
}

# ---------------------------------------------------------------------------

LOCK=/var/lock/wg_manager.lock
case "$1" in
    ""|menu|menue) ensure_env; menu ;;
    hilfe|help|-h|--help) usage ;;
    liste|list|status) ensure_env; cmd_list ;;
    netze|nets) cmd_nets ;;
    mtu-messen|mtu) ensure_env; shift; cmd_mtu_check "$1" ;;
    zeige|show) ensure_env; shift; cmd_show "$@" ;;
    qr) ensure_env; shift; cmd_qr "$1" ;;
    babel-zeige) ensure_env; shift; cmd_babel_show "$1" ;;
    *)
        # Sperre auch bei Abbruch (Strg-C, abgeschnittene Ausgabe) freigeben, sonst hängen alle weiteren Aufrufe
        [ -x /bin/lock ] && { lock "$LOCK"; trap 'lock -u "$LOCK"' EXIT; trap 'exit 1' INT TERM HUP PIPE; }
        ensure_env
        c="$1"; shift
        [ "$1" = "-q" ] && { QUIET=1; shift; }
        case "$c" in
            apply) cmd_apply ;;
            migrate) cmd_migrate "$@" ;;
            geraet-neu|peer-add) cmd_peer_add "$@" ;;
            geraet-loeschen|peer-del) cmd_peer_del "$1" ;;
            geraet-sperren) cmd_peer_enable "$1" 0 ;;
            geraet-entsperren) cmd_peer_enable "$1" 1 ;;
            tunnel-neu|tunnel-add) cmd_tunnel_add "$@" ;;
            tunnel-aendern|tunnel-edit) cmd_tunnel_edit "$@" ;;
            tunnel-loeschen|tunnel-del) cmd_tunnel_del "$1" ;;
            babel-neu) cmd_babel_add "$@" ;;
            babel-einfuegen) cmd_babel_insert "$@" ;;
            babel-mtu) cmd_babel_mtu "$1" ;;
            babel-loeschen) cmd_babel_del "$1" ;;
            babel-pruefen) cmd_babel_check ;;
            *) usage; exit 1 ;;
        esac
        ;;
esac
